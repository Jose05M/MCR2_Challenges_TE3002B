  <version>0.1.0</version>
  <description>Launch files and configuration for every stage of the Puzzlebot project</description>
  <maintainer email="eduardo.mtz1403@gmail.com">Jose Eduardo Sanchez Martinez</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

